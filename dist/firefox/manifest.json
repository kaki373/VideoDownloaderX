{
  "manifest_version": 2,
  "name": "Video Downloader",
  "version": "1.0.1",
  "description": "X (Twitter) のツイートに動画ダウンロードボタンを追加します",
  "permissions": [
    "downloads",
    "https://x.com/*",
    "https://twitter.com/*",
    "https://mobile.x.com/*",
    "https://cdn.syndication.twimg.com/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "video-downloader@local.example",
      "strict_min_version": "128.0"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*", "https://mobile.x.com/*"],
      "js": ["injected.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://x.com/*", "https://twitter.com/*", "https://mobile.x.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
